# ─────────────────────────────────────────────────────────────
#  این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
#  ⚠️ فایل .env را هرگز در گیت commit نکنید.
# ─────────────────────────────────────────────────────────────

# آدرس سایت — باید دقیقاً همان دامنه‌ای باشد که کاربر می‌بیند
SITE_URL=https://fmsmp.github.io/FMSMP

# پورت سرور پرداخت
PORT=8787

# ── زرین‌پال ─────────────────────────────────────────────────
# کد پذیرنده از پنل زرین‌پال (شکل: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
ZARINPAL_MERCHANT_ID=

# true = حالت تستی (پول واقعی جابه‌جا نمی‌شود) — اول با این تست کنید
ZARINPAL_SANDBOX=true

# ── RCON سرور ماینکرفت ───────────────────────────────────────
# در فایل server.properties سرور این‌ها را تنظیم کنید:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=یک-رمز-قوی
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# محل ذخیره سفارش‌ها
DB_FILE=./server/orders.json
